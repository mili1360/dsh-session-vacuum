# Runtime and generated state -- never commit any of this.
node_modules/
*.log

# Plugin runtime output, written under $DSH_HOME, not here. Listed so that a
# stray copy made while debugging cannot be committed by accident.
session-vacuum/
logs/

# Session logs and their backups must never enter this repo. A .orig is the
# only copy of a pruned session that exists -- it does not belong in git.
*.jsonl.zstd
*.jsonl.zstd.orig
*.vacuum-tmp

# Test scratch
test/tmp/
*.tmp

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/
