{
  "name": "dsh-session-vacuum",
  "version": "0.2.1",
  "description": "Prune the dead streaming fragments out of DSH session logs at startup, so a long session stops expanding into gigabytes when it is loaded. Destructive by design; inert and dry-run by default.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "session-log",
    "streaming-fragments",
    "vacuum",
    "prune",
    "oom",
    "long-session",
    "memory-optimization",
    "zstd"
  ],
  "license": "MIT",
  "author": "三文鱼",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mili1360/dsh-session-vacuum.git"
  },
  "homepage": "https://github.com/mili1360/dsh-session-vacuum#readme",
  "bugs": {
    "url": "https://github.com/mili1360/dsh-session-vacuum/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "test": "node test/vacuum-tests.mjs",
    "test:vacuum": "node test/vacuum-tests.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
