# Normalize line endings: the repo stores LF, checkouts are free to differ.
* text=auto eol=lf

# JS is always LF and never a binary.
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf

# Windows-only tooling in this repo is text, not binary.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Session logs are zstd frames, not text: never normalise, diff or merge them.
*.zstd binary
*.orig binary

# Never diff or merge these.
*.7z   binary
*.exe  binary
*.png  binary
*.jpg  binary
*.zip  binary
